PORT=5000
MONGO_URI=mongodb://localhost:27017/hms
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret_min_32_chars

# Firebase Authentication Configuration
FIREBASE_CREDENTIALS_PATH=./firebase-key.json
PROJECT_ID=your_firebase_project_id

# Brevo Email Configuration
# Get your API key from https://app.brevo.com/settings/account/api
BREVO_API_KEY=xkeysib-your_actual_api_key_here
BREVO_FROM_EMAIL=your-email@example.com

# OTP Configuration
OTP_EXPIRY=5

# Node Environment
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50

# Trust Proxy (for deployment behind reverse proxy)
TRUST_PROXY=false
